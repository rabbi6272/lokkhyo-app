{
  "name": "lokkhyo",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start --clear",
    "android": "expo run:android",
    "web": "expo start --web",
    "dev": "expo start -c",
    "check:errors": "tsc --noEmit && eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:dev": "npx eas build --profile development --platform android --local",
    "build:apk": "npx expo prebuild && npx eas build --profile production --platform android --local",
    "build:android": "npx expo prebuild && npx eas build --profile production --platform android",
    "build:preview": "npx expo prebuild && npx eas build --profile preview --platform android --local",
    "build:ios": "npx expo prebuild --clean && npx eas build --profile production --platform ios",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/query-async-storage-persister": "^5.104.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "expo": "^55.0.0",
    "expo-blur": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.41",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~5.9.2",
    "vitest": "^5.0.2"
  },
  "private": true
}
