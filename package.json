{
  "name": "lokkhyo",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start --clear",
    "android": "expo run:android",
    "web": "expo start --web",
    "dev": "expo start -c",
    "check:errors": "tsc --noEmit && eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:dev": "npx eas build --profile development --platform android --local",
    "build:apk": "npx expo prebuild && npx eas build --profile production --platform android --local",
    "build:android": "npx expo prebuild && npx eas build --profile production --platform android",
    "build:preview": "npx expo prebuild && npx eas build --profile preview --platform android --local",
    "build:ios": "npx expo prebuild --clean && npx eas build --profile production --platform ios",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/query-async-storage-persister": "^5.104.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "expo": "~54.0.35",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~5.9.2",
    "vitest": "^5.0.2"
  },
  "private": true
}
